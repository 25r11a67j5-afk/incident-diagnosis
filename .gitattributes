# Normalize line endings — prevents Windows/Mac/Linux merge conflicts
* text=auto eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary — never diff/merge
*.png binary
*.jpg binary
*.ico binary
